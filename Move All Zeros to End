class Solution {
    void pushZerosToEnd(int[] arr) {
        int[] res = new int[arr.length];
        int ind =0 ;
        for(int i=0;i<arr.length;i++){
            if(arr[i]!=0){
                res[ind++] = arr[i];
            }
        }
        for(int i=0;i<arr.length;i++){
            arr[i] = res[i];
        }
    }
}
