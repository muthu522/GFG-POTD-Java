class Solution {
    public int equalSumSpan(int[] a1, int[] a2) {
        int prefix = 0;
        int maxLen = 0;
            HashMap<Integer,Integer> map = new HashMap<>();
            for(int i=0;i<a1.length;i++){
                prefix+=(a1[i]-a2[i]);
                if(prefix==0){
                    maxLen = i+1;
                }
                if(map.containsKey(prefix)){
                    maxLen = Math.max(maxLen,i-map.get(prefix));
                }
                else{
                    map.put(prefix,i);
                }
            }
            return maxLen;
    }
}
