class Solution {
    public int longestSubarray(int[] arr, int k) {
        int n = arr.length;
        for(int i=0;i<n;i++){
            if(arr[i]>k){
                arr[i] = 1;
            }
            else{
                arr[i] = -1;
            }
        }
        int sum = 0;
        int maxLen = 0;
        HashMap<Integer,Integer> map = new HashMap<>();
        for(int i=0;i<n;i++){
            sum+=arr[i];
            if(sum>0){
                maxLen=i+1;
            }
            else{
            if(map.containsKey(sum-1)){
                maxLen = Math.max(maxLen,i-map.get(sum-1));
            }
            }
            if(!map.containsKey(sum)){
                map.put(sum,i);
            }
        }
        return maxLen;
    }
}
